{
    "name": "jamri/jamri",
    "description": "Collaborative office jamming and solo audio platform with .jamri compression",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "cboden/ratchet": "^0.4.4"
    },
    "autoload": {
        "psr-4": {
            "Jamri\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Jamri\\Tests\\": "tests/"
        }
    }
}
