[Unit]
Description=Jamri WebSocket daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jamri
Group=jamri
WorkingDirectory=/opt/jamri
Environment=JAMRI_ALLOWED_ORIGINS=https://jamming.zhafron.my.id
Environment=JAMRI_WS_PORT=8080
ExecStart=/usr/bin/php -d memory_limit=256M /opt/jamri/bin/websocket.php
Restart=on-failure
RestartSec=3
MemoryMax=320M
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=300
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths=/opt/jamri/data

[Install]
WantedBy=multi-user.target
